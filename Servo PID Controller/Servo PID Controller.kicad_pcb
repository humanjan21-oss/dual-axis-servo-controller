	(gr_text "RS485 - MAX485E\n\nRC6 = UART TX -> DI\nRC7 = UART RX <- RO\nRC5 = TX-RX-E\nEN=0 : RECEIVE\nEN=1 : TRANSMIT\nBUS: A / B / GND"
