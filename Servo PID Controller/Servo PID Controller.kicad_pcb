	(gr_text "VIN: +12V DC\nLOGIC: +5V / TSR2-2450\n\nSERVO: +6V / MC34063\nENC: X4 COUNT / SIGNED POS\nCTRL: POSITION + SPEED LOOP\nFAULT: OVERCURRENT / TIMEOUT\nREV: ____   FW: ____"
